# Get an API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Primary model, then fallbacks tried in order if it errors or is unavailable.
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# Optional local fallback (text only) for confidential mode, e.g. http://localhost:11434
OLLAMA_URL=
OLLAMA_MODEL=llama3.1

PORT=5000
MAX_FILE_MB=12
# Max size of a video for full video review
MAX_VIDEO_MB=60

# Where db.json and uploaded files are stored
DATA_DIR=data

# Only needed if the frontend is hosted on a different origin
FRONTEND_ORIGIN=

# One-click demo accounts on the sign-in page (for hackathon reviewers). Set to false to hide them.
DEMO_MODE=true
